<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Login - XORU</title><link rel="stylesheet" href="{{ asset('style.css') }}"></head>
<body><main class="wrap" style="min-height:100vh;display:grid;place-items:center"><section class="modal-box" style="margin:auto"><h2>Login</h2><p>Sign in to manage your XORU account or administrator dashboard.</p>
{% for message in app.flashes('success') %}<p class="success-box">{{ message }}</p>{% endfor %}{% if error %}<p class="admin-login-error">{{ error }}</p>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('authenticate') }}"><input type="text" name="login" placeholder="Email address or admin username" autocomplete="username" required><input type="password" name="password" placeholder="Password" autocomplete="current-password" required><button class="btn primary" type="submit">Login</button></form>
<p>Don't have an account? <a href="{{ path('customer_register') }}">Create Account</a></p><a class="btn outline" href="{{ path('home') }}">Back to XORU</a></section></main></body></html>