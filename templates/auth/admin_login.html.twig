<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin Login - XORU</title><link rel="stylesheet" href="{{ asset('style.css') }}"></head>
<body class="admin-page"><main class="admin-login-page"><section class="admin-login-brand"><img src="{{ asset('assets/xoru-blue.png') }}" alt="XORU Radiator Pro Logo"><p>Administrator portal for managing customer bookings, schedules, services, and repair requests.</p></section><section class="admin-login-side"><div class="admin-login-card"><h2>Admin Login</h2><p>Sign in to access the XORU Radiator Pro dashboard.</p>{% if error %}<div class="admin-login-error">{{ error }}</div>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('authenticate') }}"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required><label for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password" required><button class="login-submit" type="submit">Login</button></form><a href="{{ path('home') }}">Back to XORU</a></div></section></main></body></html>