{% extends 'admin/_layout.html.twig' %}{% block title %}XORU Admin Customers{% endblock %}{% block heading %}Customers{% endblock %}{% block content %}<div class="admin-settings-header"><h1>Customers</h1><p>Registered accounts and booking activity.</p></div><section class="admin-card"><div class="admin-card-header"><h2>Customer Accounts</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Customer</th><th>Email</th><th>Login Method</th><th>Bookings</th><th>Registered</th></tr></thead><tbody>{% for customer in customers %}<tr><td>{{ customer.name }}</td><td><a href="mailto:{{ customer.email }}">{{ customer.email }}</a></td><td>{{ customer.provider|capitalize }}</td><td>{{ customer.booking_count }}</td><td>{{ customer.created_at|date('M d, Y') }}</td></tr>{% else %}<tr><td colspan="5">No customers registered yet.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}