{% extends 'admin/_layout.html.twig' %}{% block title %}XORU Admin Reports{% endblock %}{% block heading %}Reports{% endblock %}{% block content %}<div class="admin-settings-header"><h1>Customer Reports &amp; Reviews</h1><p>Review submissions and send replies to customers.</p></div><section class="admin-card"><div class="admin-card-header"><h2>Submitted Reports</h2></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Customer</th><th>Type</th><th>Rating</th><th>Message</th><th>Status / Reply</th><th>Action</th></tr></thead><tbody>{% for report in reports %}<tr><td>{{ report.customer_name }}<br><small>{{ report.customer_email }}</small></td><td>{{ report.type }}</td><td>{{ report.rating ?: '—' }}</td><td><strong>{{ report.subject }}</strong><br>{{ report.message }}</td><td>{{ report.status }}<br>{{ report.admin_reply }}</td><td><form action="{{ path('admin_report_action') }}" method="post" class="admin-report-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_report') }}"><input type="hidden" name="report_id" value="{{ report.id }}"><select name="status"><option value="New" {{ report.status == 'New' ? 'selected' }}>New</option><option value="Read" {{ report.status == 'Read' ? 'selected' }}>Read</option><option value="Resolved" {{ report.status == 'Resolved' ? 'selected' }}>Resolved</option></select><textarea name="admin_reply" rows="2" placeholder="Reply to customer...">{{ report.admin_reply }}</textarea><button class="admin-btn primary" type="submit">Save</button></form></td></tr>{% else %}<tr><td colspan="6">No customer reports or reviews yet.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}