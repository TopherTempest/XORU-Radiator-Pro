{% extends 'base.html.twig' %}

{% block title %}XORU Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style.css') }}">
{% endblock %}

{% block javascripts %}
    <script>if (localStorage.getItem('xoruAdminTheme') === 'dark') document.documentElement.classList.add('admin-dark');</script>
{% endblock %}

{% block body %}
    <div class="admin-page">
        <div class="admin-shell">
            {% include 'partial/sidebar.html.twig' %}
            <main class="admin-main">
                <header class="admin-topbar">
                    <div class="admin-topbar-title">{% block heading %}Dashboard{% endblock %}</div>
                    <div class="admin-account"><strong>Xoru Radiator Pro</strong><small>Administrator</small></div>
                </header>
                <div class="admin-content">
                    {% for message in app.flashes('success') %}<div class="admin-alert">{{ message }}</div>{% endfor %}
                    {% for message in app.flashes('error') %}<div class="admin-login-error">{{ message }}</div>{% endfor %}
                    {% block content %}{% endblock %}
                </div>
            </main>
        </div>
    </div>
{% endblock %}